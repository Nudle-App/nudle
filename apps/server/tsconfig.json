{
  "extends": "@nudle/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "strict": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
