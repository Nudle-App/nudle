{
  "name": "@nudle/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "start": "pnpm migrate && node dist/index.js",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "better-auth": "^1.6.26",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nudle/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
