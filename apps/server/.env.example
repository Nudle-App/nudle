# From Better Auth Infrastructure dashboard (analytics / dash plugin) — optional
BETTER_AUTH_API_KEY=
# Frontend origins for cookies/CORS
CORS_ORIGIN=http://localhost:5174
TEACHER_ORIGIN=http://localhost:5174
STUDENT_ORIGIN=http://localhost:5173
# Optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
