{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "nudle-ai-landing",
      "version": "0.1.0",
      "title": "Nudle AI Landing"
    },
    "tools": [
      {
        "name": "get_site_overview",
        "title": "Get site overview",
        "description": "Get NUDLE's positioning: product name, tagline, description, headline stats, and primary calls to action.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_features",
        "title": "List platform features",
        "description": "List NUDLE's platform features with descriptions. Optionally filter by a keyword matched against the title and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional keyword to filter features, e.g. 'analytics'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_audience_benefits",
        "title": "Get audience benefits",
        "description": "Get NUDLE's value proposition for a specific audience: institutions or students.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "audience": {
              "type": "string",
              "enum": [
                "institutions",
                "students"
              ],
              "description": "Which audience to describe."
            }
          },
          "required": [
            "audience"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_testimonials",
        "title": "List testimonials",
        "description": "List public customer testimonials shown on the NUDLE site, with author, role, and institution.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
