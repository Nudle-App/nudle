# Student / teacher apps — copy into apps/<app>/.env (auth only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Leave empty in local dev (Vite proxies /api → server). Set in production to your API URL.
VITE_API_URL=

# Server: apps/server/.env — see apps/server/.env.example
# Landing page is static and needs no env.
